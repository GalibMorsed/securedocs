# Optional overrides for docker-compose.yml. Defaults work without this file.
POSTGRES_DB=securedocs
POSTGRES_USER=securedocs
POSTGRES_PASSWORD=securedocs_password
POSTGRES_PORT=5432
REDIS_PORT=6379

# Required for document embeddings and semantic search.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MONTHLY_TOKEN_LIMIT=25000000
