APP_NAME=SecureDocs
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://securedocs:securedocs_password@localhost:5432/securedocs
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JSON list
CORS_ORIGINS=["http://localhost:5173"]

# Generate a unique secret before using a non-development environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=190405
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=securedocs-api

# Uploaded files are private; local storage is outside the web root.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=private_uploads
UPLOAD_MAX_BYTES=10485760

# Embeddings use OpenRouter's Qwen3 Embedding 8B model (4096 dimensions).
# Keep the real key in the ignored backend/.env file; never commit it here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_DOCUMENT_TOKENS=100000
EMBEDDING_MAX_QUERY_TOKENS=2048
EMBEDDING_MONTHLY_TOKEN_LIMIT=25000000
CHAT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
CHAT_TIMEOUT_SECONDS=60
CHAT_MONTHLY_TOKEN_LIMIT=10000000
CHAT_MAX_OUTPUT_TOKENS=900
CHAT_HISTORY_MESSAGES=8
CHAT_CONTEXT_CHUNKS=8
RAG_MIN_SIMILARITY=0.20
OCR_LANGUAGES=eng
OCR_DPI=200
OCR_MAX_PAGES=250

# For AWS S3, set STORAGE_BACKEND=s3 and configure the bucket and region.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_PREFIX=securedocs
# S3_SERVER_SIDE_ENCRYPTION=AES256
