APP_NAME=SecureDocs
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://securedocs:securedocs_password@localhost:5432/securedocs
REDIS_URL=redis://localhost:6379/0

# JSON list
CORS_ORIGINS=["http://localhost:5173"]

# Generate a unique secret before using a non-development environment.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=development-only-change-this-secret-before-deploying
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=securedocs-api

# Uploaded files are private; local storage is outside the web root.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=private_uploads
UPLOAD_MAX_BYTES=10485760

# For AWS S3, set STORAGE_BACKEND=s3 and configure the bucket and region.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_PREFIX=securedocs
# S3_SERVER_SIDE_ENCRYPTION=AES256
